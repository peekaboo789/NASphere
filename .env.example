# 复制成 .env 再用（deploy.sh 读它）：

#   mkdir -p ./dat && cp .env.example ./dat/.env && vi ./dat/.env

# 下面几项 deploy.sh 与 docker compose 共用，不写就用默认值。
HOST_PORT=18086         # 宿主机对外端口（容器内固定监听 8080；deploy.sh --port 会覆盖它）
DATA_DIR=./data         # 数据目录，备份这一个目录即可迁移
DOCKER_SOCK=/var/run/docker.sock   # 主页 Docker 窗口用的套接字；不想给这个能力就在 docker-compose.yml 里注释掉挂载它那两行
TZ=Asia/Shanghai
# TAG=1.0.0             # 镜像标签，deploy.sh 默认取 package.json 的 version
# IMAGE=local/nasphere   # 镜像名
# CONTAINER=nasphere     # 容器名
# SESSION_DAYS=30       # 登录态有效天数（1–365）
# MAX_BODY=8388608      # 请求体上限字节数，上传壁纸 / 图标受此约束
# KEEP_BACKUPS=5        # 每次部署前把 config.json/auth.json 存进 data/.deploy-backup，留几份
